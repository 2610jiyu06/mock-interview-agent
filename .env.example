# ==============================================================================
# Mock Interview Agent - Environment Configuration
# ==============================================================================
# 
# 1. DEMO MODE (Default):
#    Leave GEMINI_API_KEY and OPENAI_API_KEY blank.
#    The application will automatically run in Demo Mode using curated
#    question banks and an intelligent rule-based scoring engine.
#
# 2. AI-POWERED MODE (Recommended):
#    Get a free API key from Google AI Studio: https://aistudio.google.com/
#    Paste your key below:
#    GEMINI_API_KEY=AIzaSy...
#
# ==============================================================================

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# Optional: Alternative OpenAI API Key
OPENAI_API_KEY=

# Preferred Gemini Model (gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Flask Application Settings
FLASK_SECRET_KEY=college-project-mock-interview-agent-2026-secret
FLASK_PORT=5000
FLASK_DEBUG=False
